# Required in every environment. Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# Local development only. Do not enable either setting on a reachable server.
DJANGO_DEBUG=True
DJANGO_LOCAL_AUTO_LOGIN=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Production example (use HTTPS and a reverse proxy configured for Django's
# SECURE_PROXY_SSL_HEADER when TLS terminates before the application).
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=planner.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://planner.example.com
